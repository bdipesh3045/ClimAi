# Copy to .env.local and adjust.
# Crop Finder posts here directly from the browser.
NEXT_PUBLIC_CROP_ANALYSIS_API_URL=http://127.0.0.1:5001/api/crop-analysis
# Server-side only: where the /backend proxy forwards sign-in and profile requests.
BACKEND_URL=http://127.0.0.1:5001
# Server-side only: Gemini API key for the AI assistant. Get one at https://aistudio.google.com/apikey
# Never prefix it with NEXT_PUBLIC_, which would send it to the browser.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Gemini model for the assistant. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
