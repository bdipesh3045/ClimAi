# The backend reads these from the environment. Nothing loads this file automatically:
# export them in your shell, for example `set -a; source .env; set +a`.

# Required. Signs the sign-in cookie. At least 32 random characters. Generate one with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
CLIMAI_SECRET_KEY=

# Optional. Where accounts and farm profiles are stored. Default: climai.db next to app.py.
# CLIMAI_DB_PATH=/path/to/climai.db
